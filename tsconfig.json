{
    "compilerOptions": {
      "module": "commonjs",
      "strict": true,
      "strictPropertyInitialization": false,
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "resolveJsonModule": true,
      "target": "es2018",
      "sourceMap": false,
      "outDir": "./dist",
      "baseUrl": "./",
      "paths": {
        "@/*": [
          "./src/*"
        ]
      },
      "typeRoots": [
        "typings/",
        "node_modules/@types/"
      ],
      "esModuleInterop": true,
      "incremental": true,
      "allowJs": true,
      "lib": [
        "DOM",
        "es2018"
      ]
    },
    "include": [
      "typings/",
      "src/**/*.ts",
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "test",
      "src/proto"
    ]
}